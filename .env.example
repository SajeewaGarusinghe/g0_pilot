# Copy to .env (setup.sh does this) and fill in. .env is ignored by git.

# --- Default: Gemini API free tier (no card needed) ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
MODEL=gemini/gemini-3.5-flash-lite
# Stay under the free tier's per-minute limit (15 RPM for this model in AI Studio on 2026-10-21).
GEMINI_RPM=12
WORKERS=1

# --- Optional: Claude through the Anthropic API (paid, prepaid credit) ---
# Key: https://platform.claude.com -> API keys. Then set MODEL=anthropic/claude-sonnet-5-5 and WORKERS=2.
ANTHROPIC_API_KEY=
MAX_COST_USD=0.50

# --- Shared ---
TEMPERATURE=0
MAX_STEPS=30
